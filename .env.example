# Backend Server Configuration
PORT=4000
CORS_ORIGIN=http://localhost:5173
SQLITE_DB_PATH=./data/unterb2b.sqlite

# Optional Real LLM Integration (Gemini or OpenAI)
# Leave blank to run the built-in deterministic AI Cargo Estimator automatically.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Frontend Vite API Proxy / Base URL
VITE_API_URL=http://localhost:4000/api
